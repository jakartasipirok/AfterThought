# Local demo defaults are used when these are unset. Never commit .env.
DATABASE_URL=postgres://afterthought:afterthought@127.0.0.1:55432/afterthought?sslmode=disable
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
AFTERTHOUGHT_TASK_QUEUE=afterthought-agent-v1
AFTERTHOUGHT_DATA_DIR=.afterthought
# The demo serves the UI and API together and starts the existing agent worker.
AFTERTHOUGHT_HTTP_ADDRESS=127.0.0.1:8080
AFTERTHOUGHT_UI_DIR=frontend

# Select a model available on your provider that supports function calling.
AFTERTHOUGHT_MODEL=gpt-6.1-sol
# auto selects Responses for GPT-6.1 Sol and Chat Completions for other models.
# Set responses or chat_completions explicitly for another compatible provider/model.
AFTERTHOUGHT_MODEL_API=auto
AFTERTHOUGHT_MODEL_BASE_URL=https://api.openai.com/v1
AFTERTHOUGHT_MODEL_API_KEY=

# Generic tool environment; there are no domain functions or seeded graphs.
AFTERTHOUGHT_SANDBOX_IMAGE=python:3.12-bookworm
# Built by make graph-runtime; every retained release pins its resolved image ID.
AFTERTHOUGHT_GRAPH_IMAGE=afterthought-ml:v1
AFTERTHOUGHT_SANDBOX_NETWORK=none
AFTERTHOUGHT_SKILLS_DIR=harness/skills

# Hindsight is the default learning layer. "local" is an explicit offline mode.
AFTERTHOUGHT_MEMORY_BACKEND=hindsight
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_PREFIX=afterthought
# The self-hosted Hindsight service also uses inference for learning/reflection.
HINDSIGHT_MODEL=gpt-4.1-mini
